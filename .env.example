PROJECT_NAME="SkillGap Analyzer API"
API_PREFIX="/api"

# Neo4j Graph Database
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# Postgres Relational DB (Optional for Phase 2, but good to have)
DATABASE_URL=postgresql://postgres:postgres@db:5432/skillgap

# Redis for background tasks (Celery)
REDIS_URL=redis://redis:6379/0
